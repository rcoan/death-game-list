<div class="login-container">
  <div class="login-card">
    <h1>Jogo do Morte</h1>
    <p class="login-subtitle">Faça login para acessar sua conta</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "login-form" }) do |f| %>
      <div class="form-group">
        <%= f.label :username, "Usuário" %>
        <%= f.text_field :username, autofocus: true, autocomplete: "username", class: "form-control", placeholder: "seu_usuario" %>
      </div>

      <div class="form-group">
        <%= f.label :password, "Senha" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "••••••••" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-group checkbox-group">
          <%= f.check_box :remember_me, class: "checkbox" %>
          <%= f.label :remember_me, "Lembrar-me", class: "checkbox-label" %>
        </div>
      <% end %>

      <div class="form-actions">
        <%= f.submit "Entrar", class: "btn btn-primary btn-block" %>
      </div>

      <% if devise_mapping.recoverable? %>
        <div class="form-footer">
          <%= link_to "Esqueceu sua senha?", new_password_path(resource_name), class: "forgot-password-link" %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
