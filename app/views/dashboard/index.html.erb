<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <h1>Dashboard - Ranking Geral</h1>
  <div>
    <label for="year-select" style="color: white; margin-right: 0.5rem;">Ano:</label>
    <select id="year-select" onchange="changeYear(this.value)" style="padding: 0.5rem 1rem; border-radius: 8px; border: 2px solid rgba(255, 255, 255, 0.3); background: rgba(255, 255, 255, 0.9); font-size: 1rem; cursor: pointer;">
      <% @available_years.each do |year| %>
        <option value="<%= year %>" <%= 'selected' if year == @current_year %>><%= year %></option>
      <% end %>
    </select>
  </div>
</div>

<script>
  function changeYear(year) {
    window.location.href = '<%= root_path %>?year=' + year;
  }
</script>

<div class="card">
  <h2>Ranking de Pontuação</h2>
  <table>
    <thead>
      <tr>
        <th>Posição</th>
        <th>Jogador</th>
        <th>Pontuação Total</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each_with_index do |user_data, index| %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= user_data[:user].email %></td>
          <td class="points"><%= user_data[:total_points] %> pontos</td>
          <td><%= link_to "Ver Lista", player_list_path(user_data[:user].id), class: "btn" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="card">
  <h2>Todas as Mortes</h2>
  <% if @all_deaths.any? %>
    <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>Idade</th>
          <th>Pontos</th>
          <th>Data da Morte</th>
        </tr>
      </thead>
      <tbody>
        <% @all_deaths.each do |celebrity| %>
          <tr>
            <td><%= celebrity.name %></td>
            <td><%= celebrity.age_at_death %> anos</td>
            <td class="points"><%= celebrity.points %> pontos</td>
            <td><%= celebrity.death_date&.strftime("%d/%m/%Y") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>Nenhuma morte registrada ainda.</p>
  <% end %>
</div>

<div class="card">
  <h2>Gráficos</h2>
  <div id="charts-container" style="display: flex; flex-direction: column; gap: 2rem;">
    <div>
      <canvas id="topPlayersChart" style="max-height: 300px;"></canvas>
    </div>
    <div>
      <canvas id="deathsTimelineChart" style="max-height: 300px;"></canvas>
    </div>
  </div>
</div>

<script>
  // Top 10 Players Chart
  window.topPlayersData = {
    labels: <%= raw @users.first(10).map { |u| u[:user].email }.to_json %>,
    datasets: [{
      label: 'Pontuação',
      data: <%= raw @users.first(10).map { |u| u[:total_points] }.to_json %>,
      backgroundColor: 'rgba(102, 126, 234, 0.7)',
      borderColor: 'rgba(118, 75, 162, 1)',
      borderWidth: 2,
      borderRadius: 8
    }]
  };

  // Deaths Timeline Chart
  window.deathsTimelineData = {
    labels: <%= raw @deaths_by_month.keys.to_json %>,
    datasets: [{
      label: 'Mortes por Mês',
      data: <%= raw @deaths_by_month.values.to_json %>,
      backgroundColor: 'rgba(102, 126, 234, 0.3)',
      borderColor: 'rgba(118, 75, 162, 1)',
      borderWidth: 3,
      fill: true,
      tension: 0.4
    }]
  };
</script>

