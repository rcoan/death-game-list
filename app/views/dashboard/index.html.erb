<div class="dashboard-header">
  <h1>Dashboard - Ranking <%= @view_year %></h1>
  <div style="display: flex; gap: 1rem; align-items: center;">
    <%= link_to "← Voltar ao Dashboard", root_path, class: "btn" %>
  </div>
</div>

<div class="card">
  <h2>Ranking de Pontuação</h2>
  <div class="table-wrapper">
    <table>
    <thead>
      <tr>
        <th>Posição</th>
        <th>Jogador</th>
        <th>Pontuação Total</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each_with_index do |user_data, index| %>
        <tr class="<%= 'champion-row' if index == 0 %>">
          <td><%= index + 1 %></td>
          <td>
            <%= display_user_with_trophies(user_data[:user]) %>
            <% if index == 0 && @view_year < Date.current.year %>
              <span style="color: #f39c12; margin-left: 0.5rem;">👑 Campeão</span>
            <% elsif index == 0 && @view_year >= Date.current.year %>
              <span style="color: #999; margin-left: 0.5rem;">🥇 Líder (ano em andamento)</span>
            <% end %>
          </td>
          <td class="points"><%= user_data[:total_points] %> pontos</td>
          <td><%= link_to "Ver Lista", player_list_path(user_data[:user].id, year: @view_year), class: "btn" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  </div>
</div>

<div class="card">
  <h2>Todas as Mortes</h2>
  <% if @all_deaths.any? %>
    <div class="table-wrapper">
      <table>
      <thead>
        <tr>
          <th>Nome</th>
          <th>Idade</th>
          <th>Pontos</th>
          <th>Data da Morte</th>
        </tr>
      </thead>
      <tbody>
        <% @all_deaths.each do |celebrity| %>
          <tr>
            <td><%= celebrity.name %></td>
            <td><%= celebrity.age_at_death %> anos</td>
            <td class="points"><%= display_points_for_year(celebrity, @view_year) %></td>
            <td><%= celebrity.death_date&.strftime("%d/%m/%Y") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  <% else %>
    <p>Nenhuma morte registrada ainda.</p>
  <% end %>
</div>

<div class="card">
  <h2>Gráficos</h2>
  <div id="charts-container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 2rem;">
    <div>
      <canvas id="topPlayersChart"></canvas>
    </div>
    <div>
      <canvas id="deathsTimelineChart"></canvas>
    </div>
    <div>
      <canvas id="pointsDistributionChart"></canvas>
    </div>
    <div>
      <canvas id="deadliestCelebritiesChart"></canvas>
    </div>
    <div>
      <canvas id="pointsVsPopularityChart"></canvas>
    </div>
    <div>
      <canvas id="ageDistributionChart"></canvas>
    </div>
    <div>
      <canvas id="uniqueNamesChart"></canvas>
    </div>
    <div>
      <canvas id="nameRepetitionChart"></canvas>
    </div>
  </div>
</div>

<script>
  // Top 10 Players Chart
  window.topPlayersData = <%= raw({
    labels: @users.first(10).map { |u| u[:user].username },
    datasets: [{
      label: 'Pontuação',
      data: @users.first(10).map { |u| u[:total_points] },
      backgroundColor: 'rgba(102, 126, 234, 0.7)',
      borderColor: 'rgba(118, 75, 162, 1)',
      borderWidth: 2,
      borderRadius: 8
    }]
  }.to_json) %>;

  // Deaths Timeline Chart (Cumulative)
  window.deathsTimelineData = <%= raw({
    labels: @deaths_by_month.keys,
    datasets: [{
      label: 'Mortes Acumuladas',
      data: @deaths_by_month.values,
      backgroundColor: 'rgba(102, 126, 234, 0.3)',
      borderColor: 'rgba(118, 75, 162, 1)',
      borderWidth: 3,
      fill: true,
      tension: 0.4,
      pointRadius: 5,
      pointHoverRadius: 7
    }]
  }.to_json) %>;

  // Points Distribution Chart
  window.pointsDistributionData = <%= raw({
    labels: @points_distribution.keys,
    datasets: [{
      label: 'Jogadores',
      data: @points_distribution.values,
      backgroundColor: [
        'rgba(231, 76, 60, 0.8)',
        'rgba(241, 196, 15, 0.8)',
        'rgba(46, 204, 113, 0.8)',
        'rgba(52, 152, 219, 0.8)',
        'rgba(155, 89, 182, 0.8)'
      ],
      borderColor: [
        'rgba(231, 76, 60, 1)',
        'rgba(241, 196, 15, 1)',
        'rgba(46, 204, 113, 1)',
        'rgba(52, 152, 219, 1)',
        'rgba(155, 89, 182, 1)'
      ],
      borderWidth: 2
    }]
  }.to_json) %>;

  // Deadliest Celebrities Chart
  window.deadliestCelebritiesData = <%= raw({
    labels: @deadliest_celebrities.map { |c| c[:name] },
    datasets: [{
      label: 'Pontos',
      data: @deadliest_celebrities.map { |c| c[:points] },
      backgroundColor: 'rgba(231, 76, 60, 0.8)',
      borderColor: 'rgba(231, 76, 60, 1)',
      borderWidth: 2
    }]
  }.to_json) %>;

  // Points vs Popularity Chart
  window.pointsVsPopularityData = <%= raw({
    datasets: [{
      label: 'Pontos vs Popularidade',
      data: @points_vs_popularity.map { |d| { x: d[:x], y: d[:y] } },
      backgroundColor: 'rgba(102, 126, 234, 0.6)',
      borderColor: 'rgba(118, 75, 162, 1)',
      borderWidth: 2,
      pointRadius: 6,
      pointHoverRadius: 8
    }]
  }.to_json) %>;
  
  // Store labels for tooltip
  window.pointsVsPopularityLabels = <%= raw(@points_vs_popularity.map { |d| d[:label] }.to_json) %>;

  // Age Distribution Chart
  window.ageDistributionData = <%= raw({
    labels: @age_distribution.keys,
    datasets: [{
      label: 'Mortes',
      data: @age_distribution.values,
      backgroundColor: 'rgba(52, 152, 219, 0.8)',
      borderColor: 'rgba(52, 152, 219, 1)',
      borderWidth: 2
    }]
  }.to_json) %>;

  // Unique Names Chart
  window.uniqueNamesData = <%= raw({
    labels: ['Nomes Únicos'],
    datasets: [{
      label: 'Quantidade de Nomes Únicos',
      data: [@unique_names_count],
      backgroundColor: 'rgba(46, 204, 113, 0.8)',
      borderColor: 'rgba(46, 204, 113, 1)',
      borderWidth: 2
    }]
  }.to_json) %>;

  // Name Repetition Distribution Chart
  window.nameRepetitionData = <%= raw({
    labels: @name_repetition_distribution.keys.map { |k| "#{k} vez#{'es' if k > 1}" },
    datasets: [{
      label: 'Quantidade de Nomes',
      data: @name_repetition_distribution.values,
      backgroundColor: 'rgba(155, 89, 182, 0.8)',
      borderColor: 'rgba(155, 89, 182, 1)',
      borderWidth: 2
    }]
  }.to_json) %>;
</script>

<style>
  .champion-row {
    background-color: #fff3cd !important;
    font-weight: bold;
  }
</style>

