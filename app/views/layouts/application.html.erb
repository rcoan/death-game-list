<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Deaths Game" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
  </head>

  <body>
    <nav>
      <div class="nav-container">
        <div class="nav-left">
          <h1><%= link_to "Jogo do Morte", root_path %></h1>
          <% if user_signed_in? %>
            <div class="year-selector-nav">
              <label for="year-select-nav">Ano:</label>
              <select id="year-select-nav" onchange="changeYearNav(this.value)">
                <% @available_years.each do |year| %>
                  <option value="<%= year %>" <%= 'selected' if year == @current_year %>><%= year %></option>
                <% end %>
              </select>
            </div>
          <% end %>
        </div>
        <div class="nav-right">
          <% if user_signed_in? %>
            <div class="nav-links">
              <%= link_to "Dashboard", root_path %>
              <%= link_to "Minha Lista", player_lists_path(year: @current_year) %>
              <%= link_to "Regras", rules_path %>
              <% if current_user.admin? %>
                <div class="nav-dropdown">
                  <button class="nav-dropdown-toggle" onclick="toggleAdminMenu(event)">
                    Admin ▼
                  </button>
                  <div class="nav-dropdown-menu" id="admin-menu">
                    <%= link_to "Celebridades", celebrities_path, class: "nav-dropdown-item" %>
                    <%= link_to "Usuários", admin_users_path, class: "nav-dropdown-item" %>
                    <%= link_to "Anos", admin_game_years_path, class: "nav-dropdown-item" %>
                    <%= link_to "Importar", admin_imports_path, class: "nav-dropdown-item" %>
                  </div>
                </div>
              <% end %>
            </div>
            <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "btn-link btn-logout", form: { style: "display: inline;" } %>
          <% else %>
            <%= link_to "Entrar", new_user_session_path, class: "btn-link" %>
          <% end %>
        </div>
      </div>
    </nav>

    <script>
      function changeYearNav(year) {
        const currentPath = window.location.pathname;
        const separator = currentPath.includes('?') ? '&' : '?';
        window.location.href = currentPath + separator + 'year=' + year;
      }

      let adminMenuOriginalParent = null;
      let adminMenuOriginalNextSibling = null;

      function moveAdminMenuOut() {
        const menu = document.getElementById('admin-menu');
        const toggle = document.querySelector('.nav-dropdown-toggle');
        
        if (menu && menu.classList.contains('show') && toggle && menu.parentNode !== document.body) {
          adminMenuOriginalParent = menu.parentNode;
          adminMenuOriginalNextSibling = menu.nextSibling;
          document.body.appendChild(menu);
          
          const rect = toggle.getBoundingClientRect();
          menu.style.position = 'fixed';
          menu.style.top = (rect.bottom + 8) + 'px';
          menu.style.left = (rect.right - 200) + 'px'; // 200px is min-width
          menu.style.right = 'auto';
          menu.style.zIndex = '10000';
        }
      }

      function moveAdminMenuBack() {
        const menu = document.getElementById('admin-menu');
        
        if (adminMenuOriginalParent && menu && menu.parentNode === document.body) {
          if (adminMenuOriginalNextSibling) {
            adminMenuOriginalParent.insertBefore(menu, adminMenuOriginalNextSibling);
          } else {
            adminMenuOriginalParent.appendChild(menu);
          }
          menu.style.position = '';
          menu.style.top = '';
          menu.style.left = '';
          menu.style.right = '';
          menu.style.zIndex = '';
          adminMenuOriginalParent = null;
          adminMenuOriginalNextSibling = null;
        }
      }

      function positionAdminMenu() {
        const menu = document.getElementById('admin-menu');
        const toggle = document.querySelector('.nav-dropdown-toggle');
        
        if (menu && menu.classList.contains('show') && toggle && menu.parentNode === document.body) {
          const rect = toggle.getBoundingClientRect();
          menu.style.top = (rect.bottom + 8) + 'px';
          menu.style.left = (rect.right - 200) + 'px';
        }
      }

      function toggleAdminMenu(event) {
        event.stopPropagation();
        const menu = document.getElementById('admin-menu');
        
        if (menu.classList.contains('show')) {
          menu.classList.remove('show');
          moveAdminMenuBack();
        } else {
          menu.classList.add('show');
          setTimeout(moveAdminMenuOut, 0);
        }
      }

      // Close dropdown when clicking outside
      document.addEventListener('click', function(event) {
        const menu = document.getElementById('admin-menu');
        const toggle = document.querySelector('.nav-dropdown-toggle');
        if (menu && toggle && !menu.contains(event.target) && !toggle.contains(event.target)) {
          menu.classList.remove('show');
          moveAdminMenuBack();
        }
      });

      // Reposition on scroll and resize
      window.addEventListener('scroll', positionAdminMenu);
      window.addEventListener('resize', positionAdminMenu);
    </script>

    <% if notice %>
      <p class="notice"><%= notice %></p>
    <% end %>

    <% if alert %>
      <p class="alert"><%= alert %></p>
    <% end %>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
