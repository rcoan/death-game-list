<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Deaths Game" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
  </head>

  <body>
    <nav>
      <div class="nav-container">
        <h1><%= link_to "Jogo do Morte", root_path %></h1>
        <div class="nav-links">
          <% if user_signed_in? %>
            <div class="year-selector-nav">
              <label for="year-select-nav">Ano:</label>
              <select id="year-select-nav" onchange="changeYearNav(this.value)">
                <% @available_years.each do |year| %>
                  <option value="<%= year %>" <%= 'selected' if year == @current_year %>><%= year %></option>
                <% end %>
              </select>
            </div>
            <%= link_to "Dashboard", root_path(year: @current_year) %>
            <%= link_to "Minha Lista", player_lists_path(year: @current_year) %>
            <% if current_user.admin? %>
              <%= link_to "Admin - Celebridades", celebrities_path %>
              <%= link_to "Admin - Usuários", admin_users_path %>
              <%= link_to "Admin - Anos", admin_game_years_path %>
            <% end %>
            <%= button_to "Sair", destroy_user_session_path, method: :delete, class: "btn-link", form: { style: "display: inline;" } %>
          <% else %>
            <%= link_to "Entrar", new_user_session_path %>
          <% end %>
        </div>
      </div>
    </nav>

    <script>
      function changeYearNav(year) {
        const currentPath = window.location.pathname;
        const separator = currentPath.includes('?') ? '&' : '?';
        window.location.href = currentPath + separator + 'year=' + year;
      }
    </script>

    <% if notice %>
      <p class="notice"><%= notice %></p>
    <% end %>

    <% if alert %>
      <p class="alert"><%= alert %></p>
    <% end %>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
