<h1>Admin - Gerenciar Usuários</h1>

<div class="card">
  <%= link_to "Criar Novo Usuário", new_admin_user_path, class: "btn btn-success" %>
</div>

<div class="card">
  <h2>Todos os Usuários</h2>
  <div class="table-wrapper">
    <table>
    <thead>
      <tr>
        <th>Email</th>
        <th>Admin</th>
        <th>Pontuação Total</th>
        <th>Celebridades na Lista</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= user.email %></td>
          <td><%= user.admin? ? "Sim" : "Não" %></td>
          <td class="points"><%= user.total_points %> pontos</td>
          <td><%= user.player_lists.count %>/20</td>
          <td>
            <%= link_to "Ver", admin_user_path(user), class: "btn" %>
            <%= link_to "Gerenciar Lista", manage_list_admin_user_path(user), class: "btn" %>
            <%= link_to "Editar", edit_admin_user_path(user), class: "btn" %>
            <%= link_to "Deletar", admin_user_path(user), method: :delete, 
                data: { confirm: "Tem certeza?" }, class: "btn btn-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  </div>
</div>

<%= link_to "Voltar", root_path, class: "btn" %>

