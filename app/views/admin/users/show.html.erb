<h1>Usuário: <%= @user.username %></h1>

<div class="card">
  <h2>Informações</h2>
  <p><strong>Usuário:</strong> <%= @user.username %></p>
  <p><strong>Admin:</strong> <%= @user.admin? ? "Sim" : "Não" %></p>
  <p><strong>Pontuação Total (<%= @current_year %>):</strong> <span class="points"><%= @user.total_points(@current_year) %> pontos</span></p>
  <p><strong>Celebridades na Lista:</strong> <%= @player_lists.count %>/20</p>
</div>

<div class="card">
  <h2>Lista de Celebridades</h2>
  <% if @player_lists.any? %>
    <div class="table-wrapper">
      <table>
      <thead>
        <tr>
          <th>Posição</th>
          <th>Nome</th>
          <th>Status</th>
          <th>Pontos</th>
        </tr>
      </thead>
      <tbody>
        <% @player_lists.each do |player_list| %>
          <tr>
            <td><%= player_list.position %></td>
            <td><%= player_list.celebrity.name %></td>
            <td>
              <% if player_list.celebrity.is_deceased? %>
                <span class="deceased">Morto</span>
              <% else %>
                <span>Vivo</span>
              <% end %>
            </td>
            <td>
              <%= display_points_for_year(player_list.celebrity, @current_year) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  <% else %>
    <p>Lista vazia.</p>
  <% end %>
</div>

<div class="card">
  <%= link_to "Gerenciar Lista", manage_list_admin_user_path(@user), class: "btn" %>
  <%= link_to "Editar", edit_admin_user_path(@user), class: "btn" %>
  <%= link_to "Voltar", admin_users_path, class: "btn" %>
</div>

