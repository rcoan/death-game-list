<h1>Gerenciar Lista de <%= @user.email %> - Ano <%= @current_year %></h1>

<div class="card">
  <h2>Adicionar Celebridade</h2>
  <%= form_with url: add_celebrity_to_list_admin_user_path(@user), method: :post, local: true, class: "autocomplete-container" do |f| %>
    <div class="form-group">
      <label for="celebrity_name">Nome da Celebridade</label>
      <input type="text" id="celebrity_name" name="celebrity_name" autocomplete="off" required>
      <div class="autocomplete-results" id="autocomplete-results"></div>
    </div>
    <%= f.submit "Adicionar", class: "btn btn-success" %>
  <% end %>
</div>

<div class="card">
  <h2>Lista (<%= @player_lists.count %>/20)</h2>
  <% if @player_lists.any? %>
    <table>
      <thead>
        <tr>
          <th>Posição</th>
          <th>Nome</th>
          <th>Status</th>
          <th>Pontos</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @player_lists.each do |player_list| %>
          <tr>
            <td><%= player_list.position %></td>
            <td><%= player_list.celebrity.name %></td>
            <td>
              <% if player_list.celebrity.is_deceased? %>
                <span class="deceased">Morto</span>
              <% else %>
                <span>Vivo</span>
              <% end %>
            </td>
            <td>
              <% if player_list.celebrity.is_deceased? %>
                <span class="points"><%= player_list.celebrity.points %> pontos</span>
              <% else %>
                -
              <% end %>
            </td>
            <td>
              <%= link_to "Remover", remove_from_list_admin_user_path(@user, player_list_id: player_list.id), 
                  method: :delete, data: { confirm: "Tem certeza?" }, class: "btn btn-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>Lista vazia. Adicione celebridades acima!</p>
  <% end %>
</div>

<%= link_to "Voltar", admin_user_path(@user), class: "btn" %>

<script>
  const celebrityInput = document.getElementById('celebrity_name');
  const resultsDiv = document.getElementById('autocomplete-results');

  if (celebrityInput && resultsDiv) {
    celebrityInput.addEventListener('input', function() {
      const query = this.value.trim();
      
      if (query.length < 2) {
        resultsDiv.classList.remove('active');
        return;
      }

      fetch(`/autocomplete/celebrities?q=${encodeURIComponent(query)}`)
        .then(response => response.json())
        .then(data => {
          resultsDiv.innerHTML = '';
          
          if (data.length > 0) {
            data.forEach(item => {
              const div = document.createElement('div');
              div.className = 'autocomplete-item';
              div.textContent = item.name + ' (já existe)';
              div.addEventListener('click', () => {
                celebrityInput.value = item.name;
                resultsDiv.classList.remove('active');
              });
              resultsDiv.appendChild(div);
            });
            resultsDiv.classList.add('active');
          } else {
            resultsDiv.classList.remove('active');
          }
        })
        .catch(error => {
          console.error('Error:', error);
        });
    });

    document.addEventListener('click', function(e) {
      if (!celebrityInput.contains(e.target) && !resultsDiv.contains(e.target)) {
        resultsDiv.classList.remove('active');
      }
    });
  }
</script>

