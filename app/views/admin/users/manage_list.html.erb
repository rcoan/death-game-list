<h1>Gerenciar Lista de <%= @user.username %> - Ano <%= @current_year %></h1>

<div class="card">
  <h2>Adicionar Celebridade</h2>
  <div class="autocomplete-container">
    <%= form_with url: add_celebrity_to_list_admin_user_path(@user), method: :post, local: true do |f| %>
      <div class="form-group">
        <label for="celebrity_name">Nome da Celebridade</label>
        <input type="text" id="celebrity_name" name="celebrity_name" autocomplete="off" required>
      </div>
      <%= f.submit "Adicionar", class: "btn btn-success" %>
    <% end %>
    <div class="autocomplete-results" id="autocomplete-results"></div>
  </div>
</div>

<div class="card">
  <h2>Lista (<%= @player_lists.count %>/20)</h2>
  <% if @player_lists.any? %>
    <div class="table-wrapper">
      <table>
      <thead>
        <tr>
          <th>Posição</th>
          <th>Nome</th>
          <th>Status</th>
          <th>Pontos</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @player_lists.each do |player_list| %>
          <tr>
            <td><%= player_list.position %></td>
            <td><%= player_list.celebrity.name %></td>
            <td>
              <% if player_list.celebrity.is_deceased? %>
                <span class="deceased">Morto</span>
              <% else %>
                <span>Vivo</span>
              <% end %>
            </td>
            <td>
              <%= display_points_for_year(player_list.celebrity, @current_year) %>
            </td>
            <td>
              <%= link_to "Remover", remove_from_list_admin_user_path(@user, player_list_id: player_list.id), 
                  method: :delete, data: { confirm: "Tem certeza?" }, class: "btn btn-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  <% else %>
    <p>Lista vazia. Adicione celebridades acima!</p>
  <% end %>
</div>

<%= link_to "Voltar", admin_user_path(@user), class: "btn" %>

<script>
  const celebrityInput = document.getElementById('celebrity_name');
  const resultsDiv = document.getElementById('autocomplete-results');
  const autocompleteContainer = document.querySelector('.autocomplete-container');
  let originalParent = null;
  let originalNextSibling = null;

  function moveAutocompleteOut() {
    if (resultsDiv && resultsDiv.classList.contains('active') && resultsDiv.parentNode === autocompleteContainer) {
      originalParent = autocompleteContainer;
      originalNextSibling = autocompleteContainer.nextSibling;
      document.body.appendChild(resultsDiv);
      
      const inputRect = celebrityInput.getBoundingClientRect();
      resultsDiv.style.position = 'fixed';
      resultsDiv.style.top = (inputRect.bottom + 4) + 'px';
      resultsDiv.style.left = inputRect.left + 'px';
      resultsDiv.style.width = inputRect.width + 'px';
      resultsDiv.style.zIndex = '10000';
    }
  }

  function moveAutocompleteBack() {
    if (originalParent && resultsDiv && resultsDiv.parentNode === document.body) {
      if (originalNextSibling) {
        originalParent.insertBefore(resultsDiv, originalNextSibling);
      } else {
        originalParent.appendChild(resultsDiv);
      }
      resultsDiv.style.position = '';
      resultsDiv.style.top = '';
      resultsDiv.style.left = '';
      resultsDiv.style.width = '';
      resultsDiv.style.zIndex = '';
      originalParent = null;
      originalNextSibling = null;
    }
  }

  function positionAutocomplete() {
    if (resultsDiv && resultsDiv.classList.contains('active') && celebrityInput && resultsDiv.parentNode === document.body) {
      const inputRect = celebrityInput.getBoundingClientRect();
      resultsDiv.style.top = (inputRect.bottom + 4) + 'px';
      resultsDiv.style.left = inputRect.left + 'px';
      resultsDiv.style.width = inputRect.width + 'px';
    }
  }

  if (celebrityInput && resultsDiv) {
    celebrityInput.addEventListener('input', function() {
      const query = this.value.trim();
      
      if (query.length < 2) {
        resultsDiv.classList.remove('active');
        moveAutocompleteBack();
        return;
      }

      fetch(`/autocomplete/celebrities?q=${encodeURIComponent(query)}`)
        .then(response => response.json())
        .then(data => {
          resultsDiv.innerHTML = '';
          
          if (data.length > 0) {
            data.forEach(item => {
              const div = document.createElement('div');
              div.className = 'autocomplete-item';
              div.textContent = item.name;
              div.addEventListener('click', () => {
                celebrityInput.value = item.name;
                resultsDiv.classList.remove('active');
                moveAutocompleteBack();
              });
              resultsDiv.appendChild(div);
            });
            resultsDiv.classList.add('active');
            setTimeout(moveAutocompleteOut, 0);
          } else {
            resultsDiv.classList.remove('active');
            moveAutocompleteBack();
          }
        })
        .catch(error => {
          console.error('Error:', error);
        });
    });

    window.addEventListener('scroll', positionAutocomplete);
    window.addEventListener('resize', positionAutocomplete);

    document.addEventListener('click', function(e) {
      if (!celebrityInput.contains(e.target) && !resultsDiv.contains(e.target)) {
        resultsDiv.classList.remove('active');
        moveAutocompleteBack();
      }
    });
  }
</script>

