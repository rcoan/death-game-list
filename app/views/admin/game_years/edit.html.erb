<h1>Editar Ano: <%= @game_year.year %></h1>

<div class="card">
  <%= form_with model: [:admin, @game_year], local: true do |f| %>
    <div class="form-group">
      <%= f.label :year, "Ano" %>
      <%= f.number_field :year, required: true, class: "form-control", min: 2000, max: 2100 %>
    </div>

    <div class="form-group">
      <%= f.label :is_active, "Ativo?" %>
      <%= f.check_box :is_active %>
    </div>

    <div class="form-group">
      <%= f.label :start_date, "Data de Início" %>
      <%= f.date_field :start_date, required: true, class: "form-control" %>
      <small class="form-text">Data a partir da qual as mortes começam a contar pontos para este ano. Mortes antes desta data não contam.</small>
    </div>

    <div class="form-group">
      <%= f.label :locked, "Bloqueado?" %>
      <%= f.check_box :locked %>
      <small class="form-text">Quando bloqueado, apenas administradores podem editar listas deste ano.</small>
    </div>

    <%= f.submit "Atualizar Ano", class: "btn btn-success" %>
    <%= link_to "Cancelar", admin_game_years_path, class: "btn" %>
  <% end %>
</div>

