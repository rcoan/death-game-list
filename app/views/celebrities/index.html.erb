<h1>Admin - Gerenciar Celebridades</h1>

<div class="card">
  <%= link_to "🔍 Verificar Duplicatas", find_duplicates_celebrities_path, class: "btn btn-primary" %>
</div>

<div class="card">
  <h2>Todas as Celebridades</h2>
  <div class="table-wrapper">
    <table>
    <thead>
      <tr>
        <th>Nome</th>
        <th>Status</th>
        <th>Idade</th>
        <th>Pontos</th>
        <th>Data da Morte</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @celebrities.each do |celebrity| %>
        <tr>
          <td>
            <% users_with_celebrity = celebrity.player_lists.includes(:user).map { |pl| pl.user.username }.uniq %>
            <% if users_with_celebrity.any? %>
              <span class="celebrity-name-tooltip" data-tooltip="<%= users_with_celebrity.join(', ') %>">
                <%= celebrity.name %>
              </span>
            <% else %>
              <%= celebrity.name %>
            <% end %>
          </td>
          <td>
            <% if celebrity.is_deceased? %>
              <span class="deceased">Morto</span>
            <% else %>
              <span>Vivo</span>
            <% end %>
          </td>
          <td><%= celebrity.age_at_death || "-" %></td>
          <td>
            <% if celebrity.points %>
              <span class="points"><%= celebrity.points %> pontos</span>
            <% else %>
              -
            <% end %>
          </td>
          <td><%= celebrity.death_date&.strftime("%d/%m/%Y") || "-" %></td>
          <td>
            <div class="action-buttons">
              <% unless celebrity.is_deceased? %>
                <%= link_to "Marcar como Morto", mark_deceased_celebrity_path(celebrity), class: "btn btn-danger" %>
              <% end %>
              <%= link_to "Mesclar", "#", class: "btn", onclick: "showMergeForm(#{celebrity.id}); return false;" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  </div>
</div>

<!-- Modal Overlay -->
<div id="merge-modal-overlay" class="modal-overlay" onclick="hideMergeForm()" style="display: none;">
  <div class="modal-content" onclick="event.stopPropagation();">
    <div class="modal-header">
      <h2>Mesclar Celebridades</h2>
      <button type="button" class="modal-close" onclick="hideMergeForm()">&times;</button>
    </div>
    <form id="merge-celebrity-form" method="post" data-turbo="false">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <div class="form-group">
        <label>Celebridade Origem (será deletada)</label>
        <input type="text" id="source_name" readonly class="form-control">
      </div>
      <div class="form-group">
        <label for="target_id">Celebridade Destino (manterá os dados)</label>
        <select name="target_id" id="target_id" required class="form-control">
          <option value="">Selecione...</option>
          <% @celebrities.each do |c| %>
            <option value="<%= c.id %>"><%= c.name %></option>
          <% end %>
        </select>
      </div>
      <div class="modal-actions">
        <button type="submit" class="btn btn-danger" onclick="return confirm('Tem certeza? A celebridade origem será deletada e todas as listas serão transferidas.');">Mesclar</button>
        <button type="button" class="btn" onclick="hideMergeForm()">Cancelar</button>
      </div>
    </form>
  </div>
</div>

<script>
  function showMergeForm(sourceId) {
    const celebrities = <%= raw @celebrities.map { |c| { id: c.id, name: c.name } }.to_json %>;
    const source = celebrities.find(c => c.id === sourceId);
    
    if (!source) {
      alert('Celebridade não encontrada!');
      return;
    }
    
    document.getElementById('source_name').value = source.name;
    document.getElementById('target_id').value = '';
    document.getElementById('merge-modal-overlay').style.display = 'flex';
    document.getElementById('merge-celebrity-form').action = '/celebrities/' + sourceId + '/merge';
    document.body.style.overflow = 'hidden';
  }

  function hideMergeForm() {
    document.getElementById('merge-modal-overlay').style.display = 'none';
    document.getElementById('source_name').value = '';
    document.getElementById('target_id').value = '';
    document.body.style.overflow = '';
  }
</script>

